# Browser TTS/STT — demo runs fully without WhatsApp providers
VITE_TTS_PROVIDER=browser
VITE_STT_PROVIDER=browser
PORT=8787

# --- Meeting path: no external WhatsApp needed ---
# Use /dashboard “Missed call → AI” + /whatsapp-demo

# --- Only free real-phone path (optional, after meeting): Meta Cloud API ---
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# 1) Create app → WhatsApp → API Setup
# 2) Generate token, copy Phone number ID, add your number under To
# 3) Send hello_world from Meta UI, reply once on phone
# 4) Fill below, set WA_PROVIDER=meta, npm run dev:all
WA_PROVIDER=auto
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_TO=+923069607679

# Skipped (paid / blocked for many PK users): Twilio, CallMeBot

# --- Tracing / router / latency (local only; see README "Tracing, router...") ---
# Browser demo posts per-turn traces to /api/trace (1 = on). Leave off for deployed builds.
VITE_TRACE=0
# TRACE_FILE=logs/traces.jsonl
TRACE_STORE_TEXT=0
TRACE_INGEST=1
# 1 = server /api/agent/turn hands off to a human on low confidence / repeated failures
ROUTER_ENFORCE=0
LATENCY_BUDGET_FIRST_AUDIO_MS=800
LATENCY_HEADROOM_MS=150
MAX_TOKENS_PER_CALL=6000
FALLBACK_TIMEOUT_MS=1500
LLM_PRIMARY_MODEL=rule-engine
LLM_FALLBACK_MODEL=rule-engine
ANSWER_CACHE_TTL_MS=600000
POLICY_VERSION=v1
EVAL_THRESHOLD=0.9

# --- Multi-agent + LLM (see README "Multi-agent, LLM, cache, cost, replay") ---
# 1 = retrieval turns use retrieval agent (BM25 over this business's config) + response agent. 0 = engine only.
MULTI_AGENT=1
# mock (default, offline, deterministic, $0) | groq | gemini | openai-compatible
LLM_PROVIDER=mock
# Free options (never commit keys):
#   groq:   free key at https://console.groq.com/keys      default model openai/gpt-oss-20b
#   gemini: free key at https://aistudio.google.com/apikey default model gemini-2.5-flash-lite
#   openai-compatible: local Ollama (free, no key) LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=llama3.2:3b
# No key for groq/gemini -> the app falls back to mock and says so.
LLM_API_KEY=
# LLM_MODEL=
# LLM_SMALL_MODEL=           # fallback tier (groq default allam-2-7b; must differ from LLM_MODEL)
# LLM_SMALL_CONTEXT_PASSAGES=1  # fallback tier context size
# LLM_SMALL_MAX_TOKENS=80       # fallback tier answer budget
# LLM_BASE_URL=
LLM_TIMEOUT_MS=8000
# Real providers (opt-in): stream for true TTFT, low reasoning effort for gpt-oss, completion floor, per-process request cap
# LLM_STREAM=1
# LLM_REASONING_EFFORT=low
# LLM_MIN_COMPLETION_TOKENS=400
# LLM_MAX_REQUESTS=
# Mock only: fixed artificial latency per model call (ms) - for local fallback experiments
MOCK_LLM_LATENCY_MS=0
# Response cache: in-memory LRU by default; set REDIS_URL to share it (e.g. local redis://127.0.0.1:6379)
# REDIS_URL=
CACHE_MAX_ENTRIES=500
# Side-effect tool deadline (ms). Progress updates never clear it; only a final result does.
TOOL_TIMEOUT_MS=2000
# Price table (dated config, USD per 1M tokens)
# LLM_PRICE_FILE=config/llm-prices.json
