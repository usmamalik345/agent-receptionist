# Browser TTS/STT — demo runs fully without WhatsApp providers
VITE_TTS_PROVIDER=browser
VITE_STT_PROVIDER=browser
PORT=8787

# --- Meeting path: no external WhatsApp needed ---
# Use /dashboard “Missed call → AI” + /whatsapp-demo

# --- Only free real-phone path (optional, after meeting): Meta Cloud API ---
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# 1) Create app → WhatsApp → API Setup
# 2) Generate token, copy Phone number ID, add your number under To
# 3) Send hello_world from Meta UI, reply once on phone
# 4) Fill below, set WA_PROVIDER=meta, npm run dev:all
WA_PROVIDER=auto
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_TO=+923069607679

# Skipped (paid / blocked for many PK users): Twilio, CallMeBot

# --- Tracing / router / latency (local only; see README "Tracing, router...") ---
# Browser demo posts per-turn traces to /api/trace (1 = on). Leave off for deployed builds.
VITE_TRACE=0
# TRACE_FILE=logs/traces.jsonl
TRACE_STORE_TEXT=0
TRACE_INGEST=1
# 1 = server /api/agent/turn hands off to a human on low confidence / repeated failures
ROUTER_ENFORCE=0
LATENCY_BUDGET_FIRST_AUDIO_MS=800
LATENCY_HEADROOM_MS=150
MAX_TOKENS_PER_CALL=6000
FALLBACK_TIMEOUT_MS=1500
LLM_PRIMARY_MODEL=rule-engine
LLM_FALLBACK_MODEL=rule-engine
ANSWER_CACHE_TTL_MS=600000
POLICY_VERSION=v1
EVAL_THRESHOLD=0.9
